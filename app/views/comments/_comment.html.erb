<div class="index-items">
  <div class="index-item">
    <div id="<%= dom_id comment %>">

      <p>
        <strong><%= Comment.human_attribute_name(:name) %>:</strong>
        <%= link_to current_user_name(comment.user), user_path(comment.user) %>
      </p>

      <p>
        <strong><%= Comment.human_attribute_name(:created_at) %>:</strong>
        <%= l comment.created_at.in_time_zone, format: :long %>
      </p>

      <p>
        <strong><%= Comment.human_attribute_name(:content) %>:</strong>
        <%= comment.content %>
      </p>

      <% if current_user == comment.user %>
        <p>
          <%= link_to t('views.common.edit', name: Comment.model_name.human.downcase), edit_comment_path(comment) %>
        </p>
        <%= button_to t('views.common.destroy', name: Comment.model_name.human.downcase), comment, params: {comment_id: comment.id, content: comment.content}, method: :delete %>
      <% end %>
    </div>
  </div>
</div>
